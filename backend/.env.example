# Copie este archivo como .env y complete los valores.
# El archivo .env NO se sube al repositorio.

# Local (SQLite, sin instalar nada):
DATABASE_URL=sqlite:///./viva.db

# Produccion (Neon). Copie la cadena desde el panel de Neon:
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require

# Genere una clave larga y aleatoria con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambie-esto-por-una-clave-larga-y-aleatoria
JWT_MINUTOS_EXPIRACION=30

# En produccion ponga aqui la URL exacta del frontend en Vercel:
CORS_ORIGENES=*
